# Required for live YouTube videos + Shorts (no API key).
# Find it at youtube.com/account_advanced, or in any channel URL: /channel/UC...
YOUTUBE_CHANNEL_ID=

# Optional. If set, the site pulls latest Instagram posts and Reels.
# Create a Meta app, connect a Business/Creator Instagram account, and paste a long-lived token.
INSTAGRAM_ACCESS_TOKEN=

# Optional comma-separated Instagram post or reel URLs used when no token is set.
# Example: https://www.instagram.com/reel/XXXX/,https://www.instagram.com/p/YYYY/
INSTAGRAM_POST_URLS=https://www.instagram.com/reel/DfexBRrost7/?utm_source=ig_web_copy_link&dlrf=MzRlODBiNWFlZA==&srtk=MzRlODBiNWFlZA==
